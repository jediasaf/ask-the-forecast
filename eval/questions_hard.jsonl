{"id": "hard-01", "category": "multi_hop", "q": "Across the three walk-forward folds, is FOODS_1's forecast value add improving or deteriorating?", "expect_tools": ["get_fold_accuracy"], "tool_match": "all", "expect_values": [{"metric": "fva_fold1", "dept": "FOODS_1", "value": -16.3}, {"metric": "fva_fold3", "dept": "FOODS_1", "value": 4.3}], "expect_unanswerable": false, "expect_depts": ["FOODS_1"]}
{"id": "hard-02", "category": "multi_hop", "q": "Which department's forecast value add deteriorates most steadily across the three backtest folds?", "expect_tools": ["get_fold_accuracy"], "tool_match": "all", "expect_values": [{"metric": "fva_fold1", "dept": "HOUSEHOLD_1", "value": -5.0}, {"metric": "fva_fold3", "dept": "HOUSEHOLD_1", "value": -12.3}], "expect_unanswerable": false, "expect_depts": ["HOUSEHOLD_1"]}
{"id": "hard-03", "category": "multi_hop", "q": "In December 2013, which departments actually beat the naive baseline?", "expect_tools": ["get_window_accuracy"], "tool_match": "all", "expect_values": [{"metric": "fva_dec", "dept": "FOODS_1", "value": 10.2}, {"metric": "fva_dec", "dept": "HOBBIES_1", "value": 4.2}, {"metric": "fva_dec", "dept": "HOBBIES_2", "value": 6.3}], "expect_unanswerable": false, "expect_depts": ["FOODS_1", "HOBBIES_1", "HOBBIES_2"]}
{"id": "hard-04", "category": "multi_hop", "q": "What was FOODS_3's single worst forecast day, and would the naive baseline have done better on that day?", "expect_tools": ["get_worst_days"], "tool_match": "all", "expect_values": [{"metric": "abs_error", "dept": "FOODS_3", "value": 2431.5}, {"metric": "naive_abs_error", "dept": "FOODS_3", "value": 1755.0}], "expect_unanswerable": false, "expect_depts": ["FOODS_3"]}
{"id": "hard-05", "category": "multi_hop", "q": "Which department had the largest single-day absolute forecast error anywhere in the backtest, and what happened that day?", "expect_tools": ["get_worst_days"], "tool_match": "all", "expect_values": [{"metric": "abs_error", "dept": "FOODS_3", "value": 2431.5}], "expect_unanswerable": false, "expect_depts": ["FOODS_3"]}
{"id": "hard-06", "category": "multi_hop", "q": "FOODS_1 loses to the naive baseline over the whole backtest — was that also true in December 2013?", "expect_tools": ["get_value_add", "get_window_accuracy"], "tool_match": "all", "expect_values": [{"metric": "fva_overall", "dept": "FOODS_1", "value": -7.3}, {"metric": "fva_dec", "dept": "FOODS_1", "value": 10.2}], "expect_unanswerable": false, "expect_depts": ["FOODS_1"]}
{"id": "hard-07", "category": "multi_hop", "q": "Does FOODS_1 ever beat the naive baseline in any single backtest fold?", "expect_tools": ["get_fold_accuracy"], "tool_match": "all", "expect_values": [{"metric": "fva_fold3", "dept": "FOODS_1", "value": 4.3}], "expect_unanswerable": false, "expect_depts": ["FOODS_1"]}
{"id": "hard-08", "category": "multi_hop", "q": "Several departments share the same worst forecast day. What date is it, and what does the data show happened?", "expect_tools": ["get_worst_days"], "tool_match": "all", "expect_values": [{"metric": "abs_error", "dept": "FOODS_3", "value": 2431.5}], "expect_unanswerable": false}
{"id": "hard-09", "category": "multi_hop", "q": "Is HOBBIES_2's edge over the naive baseline consistent across the three folds, and what happens to its raw accuracy over the same period?", "expect_tools": ["get_fold_accuracy"], "tool_match": "all", "expect_values": [{"metric": "fva_fold1", "dept": "HOBBIES_2", "value": 11.7}, {"metric": "fva_fold3", "dept": "HOBBIES_2", "value": 12.3}, {"metric": "fa_fold3", "dept": "HOBBIES_2", "value": 60.6}], "expect_unanswerable": false, "expect_depts": ["HOBBIES_2"]}
