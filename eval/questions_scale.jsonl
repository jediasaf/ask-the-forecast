{"id": "scale-01", "category": "single_lookup", "q": "Which store sells the most units?", "expect_tools": ["list_stores"], "tool_match": "all", "expect_values": [{"metric": "volume", "dept": "ANY", "value": 1677378}], "expect_unanswerable": false}
{"id": "scale-02", "category": "single_lookup", "q": "What's the biggest-selling individual SKU at CA_1, and how many units did it move?", "expect_tools": ["find_skus"], "tool_match": "all", "expect_values": [{"metric": "sku_volume", "dept": "ANY", "value": 25367}], "expect_unanswerable": false}
{"id": "scale-03", "category": "comparison", "q": "Which store has the best seasonal-naive accuracy, and which the worst?", "expect_tools": ["list_stores"], "tool_match": "all", "expect_values": [{"metric": "best_naive_fa", "dept": "ANY", "value": 91.2}, {"metric": "worst_naive_fa", "dept": "ANY", "value": 79.0}], "expect_unanswerable": false}
{"id": "scale-04", "category": "comparison", "q": "Is HOBBIES_2 hard for the naive baseline everywhere, or is that specific to the CA_1 store?", "expect_tools": ["compare_stores"], "tool_match": "all", "expect_values": [{"metric": "worst_store_naive_fa", "dept": "ANY", "value": 40.4}, {"metric": "best_store_naive_fa", "dept": "ANY", "value": 64.0}], "expect_unanswerable": false}
{"id": "scale-05", "category": "multi_hop", "q": "Of the three states, which one contains the store with the weakest naive baseline?", "expect_tools": ["list_stores"], "tool_match": "all", "expect_values": [{"metric": "naive_fa", "dept": "ANY", "value": 79.0}], "expect_unanswerable": false}
{"id": "scale-06", "category": "multi_hop", "q": "Which FOODS_3 SKU has the worst naive accuracy among items that sold at least 1,000 units, and what is that accuracy?", "expect_tools": ["find_skus"], "tool_match": "all", "expect_values": [{"metric": "naive_fa", "dept": "ANY", "value": -30.7}, {"metric": "volume", "dept": "ANY", "value": 1462}], "expect_unanswerable": false}
{"id": "scale-07", "category": "multi_hop", "q": "Take the most intermittent SKU that still sold at least 100 units — on what share of days does it sell nothing at all?", "expect_tools": ["find_skus"], "tool_match": "all", "expect_values": [{"metric": "zero_day_pct", "dept": "ANY", "value": 85.2}], "expect_unanswerable": false}
